// 2026-05-15 · /midias/outbound/<kind>/<id>.<ext> · serve mídia outbound do
// corretor pra que iOS Safari consiga tocar (S3 .ogg/opus da VAI não toca no
// Safari) e pra termos cópia local de tudo que mandamos.
const PROJECT_ROOT       = path.resolve(process.cwd(), "..");
const OUTBOUND_DIR       = path.join(PROJECT_ROOT, "Midias", "outbound");
const OUTBOUND_AUDIO_DIR = path.join(OUTBOUND_DIR, "audio");
for (const sub of ["audio", "image", "video", "document", "file"]){
  try { mkdirSync(path.join(OUTBOUND_DIR, sub), { recursive: true }); } catch {}
}

// 2026-05-15 · Limites e MIMEs aceitos pela Meta WhatsApp Cloud API.
// Checados antes do uploadMedia pra dar erro claro em vez de deixar Meta
// retornar "media format not supported" / "file too large" obscuros.
const META_MEDIA_LIMITS_MB = { audio: 16, image: 5, video: 16, document: 100, file: 100 };
const META_ALLOWED_MIMES = {
  audio:    /^audio\/(aac|amr|mp4|mpeg|ogg)$/,
  image:    /^image\/(jpeg|png)$/,
  video:    /^video\/(mp4|3gpp?)$/,
  document: /^(application\/(pdf|msword|vnd\.openxmlformats-officedocument\.(wordprocessingml\.document|spreadsheetml\.sheet|presentationml\.presentation)|vnd\.ms-(excel|powerpoint))|text\/plain)$/,
  file:     /^(application\/(pdf|msword|vnd\.openxmlformats-officedocument\.(wordprocessingml\.document|spreadsheetml\.sheet|presentationml\.presentation)|vnd\.ms-(excel|powerpoint))|text\/plain)$/
};
const _extFromMime = (m) => {
  const t = String(m||"").toLowerCase();
  if (t.includes("jpeg")) return "jpg";
  if (t.includes("png"))  return "png";
  if (t.includes("mp4") && t.startsWith("video")) return "mp4";
  if (t.includes("3gp"))  return "3gp";
  if (t.includes("pdf"))  return "pdf";
  if (t.includes("ogg"))  return "ogg";
  if (t.includes("opus")) return "ogg";
  if (t.includes("mpeg") && t.startsWith("audio")) return "mp3";
  if (t.includes("mp4") && t.startsWith("audio")) return "m4a";
  if (t.includes("aac"))  return "aac";
  return (t.split("/")[1] || "bin").replace(/[^a-z0-9]/g,"").slice(0,5);
};

const r = Router();
const uploadMedia = multer({ storage: multer.memoryStorage(), limits: { fileSize: 25 * 1024 * 1024 } });

