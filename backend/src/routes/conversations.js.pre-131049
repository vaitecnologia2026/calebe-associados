// Map in-memory · convId → timestamp do último auto-heal.
// 2026-05-06 · TTL reduzido de 30min → 5min: quando o WhatsApp da VAI volta
// (ex.: corretor reconecta no painel), o sistema retoma rebind/redelivery em
// até 5min em vez de bloquear por meia hora. Continua suficiente pra evitar
// rebind em loop durante uma queda real, sem prolongar a indisponibilidade.
const _autoHealedConvs = new Map();
const _AUTO_HEAL_TTL_MS = 5 * 60 * 1000;
const _hasAutoHealed = (id) => {
  const t = _autoHealedConvs.get(id);
  if (!t) return false;
  if (Date.now() - t > _AUTO_HEAL_TTL_MS){ _autoHealedConvs.delete(id); return false; }
  return true;
};

// 2026-05-07 · cache de chat fresco recente · convId -> { vaiConvId, lastSuccessAt }
//   Após primeira msg via vaiSendOutboundFresh (close-all + create + send), salva
//   o chatId fresco aqui. Mensagens subsequentes (dentro do TTL) REUSAM esse chat
//   via vaiSendChatMessage direto, em vez de fechar/criar de novo a cada msg.
//   Motivo: VAI/WhatsApp Web não dispara mensagens em rajada de close+create
//   consecutivos · 1ª chega, 2ª-Nª desaparecem silenciosamente.
//   Se o reuse falhar (chat fechado externamente, etc), cai no fluxo OUTBOUND-FRESH.
const _freshChatReuseCache = new Map();
const _FRESH_REUSE_TTL_MS = 10 * 60 * 1000;
const _getFreshReuse = (id) => {
  const c = _freshChatReuseCache.get(id);
  if (!c) return null;
  if (Date.now() - c.lastSuccessAt > _FRESH_REUSE_TTL_MS){
    _freshChatReuseCache.delete(id);
    return null;
  }
  return c;
};
const _setFreshReuse = (id, vaiConvId) => {
  _freshChatReuseCache.set(id, { vaiConvId, lastSuccessAt: Date.now() });
};
