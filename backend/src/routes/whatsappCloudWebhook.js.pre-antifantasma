// Diretório onde mídias inbound (áudio/imagem/vídeo/doc/sticker) são salvas.
// Servido publicamente em /midias/inbound (server.js · express.static).
// 2026-05-13 · ALINHADO COM server.js · MIDIAS_DIR = process.cwd()/../Midias.
// Antes usava process.cwd() (sem ..) e arquivos iam pro backend/Midias enquanto
// express.static servia de cima · TODOS retornavam 404. Bug do áudio da Josimari.
const PROJECT_ROOT = path.resolve(process.cwd(), "..");
const INBOUND_ROOT = path.join(PROJECT_ROOT, "Midias", "inbound");
for (const sub of ["audio", "image", "video", "document", "sticker"]){
  try { fs.mkdirSync(path.join(INBOUND_ROOT, sub), { recursive: true }); } catch {}
}

const execFileP = promisify(execFile);

// 2026-06-03 · Áudio do WhatsApp vem em ogg/opus, que iPhone/Safari NÃO tocam.
// Converte pra MP3 (libmp3lame) — toca em iOS, Android e desktop. Se falhar,
// mantém o ogg (Android/PC ainda tocam). Mono 64k é ótimo p/ voz e leve.
async function transcodeOggToMp3(inPath, outPath){
  await execFileP("ffmpeg", [
    "-y", "-i", inPath,
    "-vn", "-codec:a", "libmp3lame", "-ac", "1", "-b:a", "64k",
    outPath
  ], { timeout: 20000 });
}

/**
 * Baixa a mídia inbound da Meta (2-step Graph) e salva em disco.
 * Retorna `{ fileUrl, fileName, mimeType }` ou null em falha (não bloqueia a
 * persistência da mensagem · texto auxiliar fica visível mesmo sem o arquivo).
 */
async function _fetchAndStoreMedia({ mediaId, kind, originalFilename, waMessageId }){
  if (!mediaId) return null;
  try {
    const { buffer, mimeType, extension } = await downloadInboundMedia(mediaId);
    const safeId = String(waMessageId || mediaId).replace(/[^a-zA-Z0-9._-]/g, "_").slice(0, 80);
    const filename = `${Date.now()}-${safeId}.${extension}`;
    const dir = path.join(INBOUND_ROOT, kind);
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(path.join(dir, filename), buffer);

    // 2026-06-03 · áudio (ogg/opus) → mp3 pra tocar no iPhone também.
    if (kind === "audio" && /ogg|opus/i.test(`${mimeType} ${extension}`)){
      try {
        const mp3Name = filename.replace(/\.[^.]+$/, "") + ".mp3";
        await transcodeOggToMp3(path.join(dir, filename), path.join(dir, mp3Name));
        return {
          fileUrl:  `/midias/inbound/${kind}/${mp3Name}`,
          fileName: (originalFilename || filename).replace(/\.[^.]+$/, "") + ".mp3",
          mimeType: "audio/mpeg"
        };
      } catch (eT){
        logger.warn({ err: eT.message, waMessageId }, "wa_cloud · transcode ogg→mp3 falhou · mantém ogg");
      }
    }

    return {
      fileUrl:  `/midias/inbound/${kind}/${filename}`,
      fileName: originalFilename || filename,
      mimeType
    };
  } catch (e){
    logger.error({ err: e.message, mediaId, kind, waMessageId }, "wa_cloud · falha ao baixar mídia inbound");
    return null;
  }
}

const r = Router();

// ----- GET /api/webhooks/whatsapp-cloud  · handshake da Meta ---------------

r.get("/", (req, res) => {
  if (!isEnabled()) return res.status(503).type("text/plain").send("disabled");
  const mode      = String(req.query["hub.mode"] || "");
  const token     = String(req.query["hub.verify_token"] || "");
  const challenge = String(req.query["hub.challenge"] || "");
  const result = verifyWebhookSubscription({ mode, token, challenge });
  if (result.ok){
    logger.info({ mode }, "✅ wa_cloud · webhook verify ok");
    return res.status(200).type("text/plain").send(result.challenge);
  }
  logger.warn({ mode, err: result.error }, "❌ wa_cloud · webhook verify rejected");
  return res.status(result.status || 403).type("text/plain").send(result.error || "rejected");
});

// ----- POST /api/webhooks/whatsapp-cloud · eventos -------------------------

// Raw body parser (1MB limite, padrão da Meta)
r.use(raw({ type: "*/*", limit: "1mb" }));

r.post("/", async (req, res) => {
  if (!isEnabled()) return res.status(503).json({ error: "disabled" });

  const rawBody = Buffer.isBuffer(req.body) ? req.body : Buffer.from(req.body || "");
  const signature = req.headers["x-hub-signature-256"] || req.headers["x-hub-signature"] || "";

  // HMAC check
  if (!verifyWebhookSignature(rawBody, signature)){
    await db.webhookInboundLog.create({
      data: {
        source: "whatsapp_cloud",
        endpoint: "/api/webhooks/whatsapp-cloud",
        rawPayload: {},
        signature: String(signature || ""),
        ipAddress: req.ip,
        status: "REJECTED",
        errorMessage: "invalid_hmac"
      }
    }).catch(()=>{});
    logger.warn({ ip: req.ip, hasSig: Boolean(signature) }, "wa_cloud · HMAC invalido");
    return res.status(401).json({ error: "invalid_signature" });
  }

  // Parse body
  let event; try { event = JSON.parse(rawBody.toString("utf8") || "{}"); }
  catch { return res.status(400).json({ error: "invalid_json" }); }

  // Log centralizado
  const inboundLog = await db.webhookInboundLog.create({
    data: {
      source: "whatsapp_cloud",
      endpoint: "/api/webhooks/whatsapp-cloud",
      rawPayload: event,
      signature: String(signature || ""),
      ipAddress: req.ip,
      status: "PROCESSING"
    }
  });

  // Responder 200 RAPIDO (Meta deslista webhook se demorar). Processamento real
  // continua em background — mas precisa garantir persistência das partes
  // críticas ANTES de responder pra não perder eventos (Meta NÃO retenta após 2xx).
  // Estratégia: aguarda persistência das mensagens, MAS sse push e audit são fire-and-forget.
  try {
    const entries = Array.isArray(event.entry) ? event.entry : [];
    let messagesProcessed = 0;
    let statusesProcessed = 0;

    for (const entry of entries){
      const changes = Array.isArray(entry.changes) ? entry.changes : [];
      for (const change of changes){
        if (change.field !== "messages") continue;
        const value = change.value || {};
        const messages = Array.isArray(value.messages) ? value.messages : [];
        const statuses = Array.isArray(value.statuses) ? value.statuses : [];
        const contacts = Array.isArray(value.contacts) ? value.contacts : [];

        // 2026-06-03 · Números exclusivos de SUPORTE — não criam leads nem conversas.
        // Mensagens recebidas por esses phone_number_ids são ignoradas pelo pipeline
        // de leads. Conversas já existentes no VAI CRM continuam ativas normalmente.
        const SUPPORT_ONLY_PHONE_IDS = new Set([
          "1143966188797246",  // +55 47 9211-7994 (suporte)
          "1155522184305211",  // +55 47 9238-0420 (suporte)
        ]);
        const incomingPhoneId = String(value.metadata?.phone_number_id || "");
        if (incomingPhoneId && SUPPORT_ONLY_PHONE_IDS.has(incomingPhoneId)){
          logger.info({ phoneId: incomingPhoneId }, "📵 webhook · número de suporte · inbound ignorado pelo pipeline de leads");
          continue; // pula o processamento de mensagens deste change
        }

        // Mapa wa_id -> profile.name (para nome do lead em inbound novo)
        const profileByWaId = new Map();
        for (const c of contacts){
          if (c.wa_id) profileByWaId.set(String(c.wa_id), c.profile?.name || null);
        }

        for (const msg of messages){
          try {
            await processInboundMessage({ msg, value, profileName: profileByWaId.get(String(msg.from)) || null });
            messagesProcessed++;
          } catch (e){
            logger.error({ err: e.message, msgId: msg.id }, "wa_cloud · falha ao processar inbound");
          }
        }

        for (const s of statuses){
          try {
            await processStatus(s);
            statusesProcessed++;
          } catch (e){
            logger.error({ err: e.message, msgId: s.id }, "wa_cloud · falha ao processar status");
          }
        }
      }
    }

    await db.webhookInboundLog.update({
      where: { id: inboundLog.id },
      data: { status: "PROCESSED", errorMessage: `msgs=${messagesProcessed} statuses=${statusesProcessed}` }
    }).catch(()=>{});
    res.status(200).json({ ok: true });
  } catch (e){
    logger.error({ err: e.message }, "wa_cloud · erro fatal no processamento");
    await db.webhookInboundLog.update({
      where: { id: inboundLog.id },
      data: { status: "REJECTED", errorMessage: e.message }
    }).catch(()=>{});
    res.status(500).json({ error: "processing_failed" });
  }
});

