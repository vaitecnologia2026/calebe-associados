# =============================================================================
# BACKEND · CRM CALEBE ASSOCIADOS — Variáveis de Ambiente
# =============================================================================

# --- Servidor -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# --- Banco de dados (PostgreSQL 16) ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_calebe?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/crm_calebe?schema=public

# --- JWT / Auth ---------------------------------------------------------------
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_48_bytes_base64
JWT_REFRESH_SECRET=change_me_refresh_48_bytes_base64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Senha inicial dos usuários seed (trocar após primeiro login)
SEED_DEFAULT_PASSWORD=Calebe@2026!

# --- Criptografia (AES-256-GCM) ----------------------------------------------
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=change_me_32_bytes_base64

# --- MinIO (upload de documentos) --------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=calebe-documentos

# --- VAI API (WhatsApp) ------------------------------------------------------
VAI_API_BASE_URL=https://api.vaicrm.com.br
VAI_API_TOKEN=
VAI_INSTANCE_ID=
VAI_SENDER_PHONE=
VAI_WEBHOOK_SECRET=

# --- WhatsApp Cloud API oficial Meta · corretor↔lead (2026-05-11) ------------
# Liga/desliga TODO o módulo Cloud API. Se "false" ou ausente, os endpoints
# retornam 503 e o webhook recusa requisições. Comunicação corretor↔lead segue
# pela VAI até este flag virar "true".
WHATSAPP_CLOUD_ENABLED=false

# System User token (Business Manager → Settings → System Users → Generate token)
# Escopos obrigatórios: whatsapp_business_management + whatsapp_business_messaging
# Marcar "Token nunca expira" no Meta. Cuide, equivale a senha.
WHATSAPP_CLOUD_TOKEN=

# Phone Number ID (Meta WhatsApp Manager → Números de telefone → detalhes)
# Para a Calebe é o número +55 48 8846-6727 · ID atual: 1075588368977371
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID · Business Manager → WhatsApp Accounts
# Calebe: 910162028578816
WHATSAPP_WABA_ID=

# App Secret (chave HMAC do webhook) · Meta App Dashboard → Configurações Básicas
# OBRIGATÓRIO para validar X-Hub-Signature-256 dos webhooks. Sem ele, todos
# webhooks são rejeitados (proteção contra requests forjadas).
WHATSAPP_APP_SECRET=

# Verify token do webhook · qualquer string secreta gerada (sugestão: openssl rand -hex 32)
# Tem que ser EXATAMENTE o mesmo configurado no Meta App Dashboard → WhatsApp → Webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Versão da Graph API (default v21.0 se omitido)
WHATSAPP_GRAPH_VERSION=v21.0

# --- Webhook receiver de LEADS (ads externos, formulários) -------------------
WEBHOOK_LEADS_SECRET=

# --- Rate limit ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# --- Regras de distribuição padrão (podem ser sobrescritas em settings) ------
QUOTA_BRONZE=1
QUOTA_SILVER=2
QUOTA_GOLD=3
QUOTA_DIAMOND=5

RATIO_DIAMOND=40
RATIO_GOLD=30
RATIO_SILVER=20
RATIO_BRONZE=10

INATIVIDADE_MINUTOS=20
MAX_REDISTRIBUICOES=3
